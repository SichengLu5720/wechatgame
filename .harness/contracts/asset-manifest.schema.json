{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/gamedev-harness/asset-manifest.schema.json",
  "title": "GameDev Harness Asset Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "requirement_id",
    "requirement_version",
    "build_revision",
    "status",
    "assets",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "task_id": { "type": "string", "minLength": 1 },
    "requirement_id": { "type": "string", "minLength": 1 },
    "requirement_version": { "type": "integer", "minimum": 1 },
    "build_revision": { "type": "integer", "minimum": 1 },
    "contract_digest": { "type": ["string", "null"] },
    "status": {
      "enum": ["Art Ready", "Art QA Failed", "Needs PM Decision", "Blocked"]
    },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/asset" }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["technical_qa", "visual_qa", "failed_or_unverified", "requires_human_approval"],
      "properties": {
        "technical_qa": { "type": "string" },
        "visual_qa": { "type": "string" },
        "failed_or_unverified": {
          "type": "array",
          "items": { "type": "string" }
        },
        "requires_human_approval": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "result", "evidence"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "result": {
          "enum": ["Pass", "Fail", "Not Verified", "Not Applicable"]
        },
        "evidence": { "type": "string" }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "artifact_path",
        "media_type",
        "status",
        "technical_checks",
        "visual_checks",
        "assumptions",
        "deviations"
      ],
      "properties": {
        "asset_id": { "type": "string", "minLength": 1 },
        "artifact_path": { "type": "string", "minLength": 1 },
        "source_path": { "type": ["string", "null"] },
        "media_type": { "type": "string", "minLength": 1 },
        "width": { "type": ["integer", "null"], "minimum": 1 },
        "height": { "type": ["integer", "null"], "minimum": 1 },
        "alpha": { "type": ["boolean", "null"] },
        "frame_count": { "type": ["integer", "null"], "minimum": 1 },
        "frame_grid": { "type": ["string", "null"] },
        "checksum": { "type": ["string", "null"] },
        "status": {
          "enum": ["Ready", "Failed", "Partial", "Not Produced"]
        },
        "technical_checks": {
          "type": "array",
          "items": { "$ref": "#/$defs/check" }
        },
        "visual_checks": {
          "type": "array",
          "items": { "$ref": "#/$defs/check" }
        },
        "assumptions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "deviations": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
